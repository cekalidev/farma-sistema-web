# Plantilla de nginx para la SPA. El entrypoint la procesa con envsubst
# (solo variables API_*) y la deja en /etc/nginx/conf.d/default.conf,
# dentro del bloque http.

# Caché por ruta: assets con hash = inmutables; el resto (index.html) se revalida.
# Vacío = no se añade la cabecera (la API decide su propia caché).
map $uri $cabecera_cache {
    ~^/assets/  "public, max-age=31536000, immutable";
    ~^/api/     "";
    default     "no-cache";
}

# Correlación: se respeta el X-Request-Id entrante o se genera uno
map $http_x_request_id $id_peticion {
    ""      $request_id;
    default $http_x_request_id;
}

# Si hay un balanceador TLS delante, se conserva su esquema
map $http_x_forwarded_proto $esquema_reenviado {
    ""      $scheme;
    default $http_x_forwarded_proto;
}

server {
    listen 8080;
    listen [::]:8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    charset utf-8;
    client_max_body_size 2m;

    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Cabeceras comunes. Ningún location define add_header para no perder la herencia.
    add_header Cache-Control $cabecera_cache always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header X-Request-Id $id_peticion always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    # API en el mismo origen: el navegador puede leer Retry-After e Idempotent-Replayed
    location ^~ /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $esquema_reenviado;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Request-Id $id_peticion;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Assets con hash: si no existe, 404 (nunca index.html)
    location ^~ /assets/ {
        try_files $uri =404;
    }

    # Archivos estáticos sueltos (favicon, mockServiceWorker.js...): 404 si faltan
    location ~* \.(?:js|mjs|css|map|json|txt|ico|svg|png|jpe?g|webp|woff2?)$ {
        try_files $uri =404;
    }

    # Fallback de la SPA (React Router)
    location / {
        try_files $uri /index.html;
    }
}
